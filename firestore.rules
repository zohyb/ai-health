rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - authenticated users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Diagnosis history - authenticated users can read/write
    match /diagnosis_history/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // Doctors collection - OPEN read for browsing, authenticated write
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Appointments collection - authenticated users can read/create/update
    match /appointments/{appointmentId} {
      allow read, write: if request.auth != null;
    }
  }
}
